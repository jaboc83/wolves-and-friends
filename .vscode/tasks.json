{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Wolves: dev",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/run-framework.mjs",
        "dev",
        "--host",
        "127.0.0.1",
        "--strictPort"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "WF_DEBUG_WORKER": "true", "NO_COLOR": "1" }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:.*http://127\\.0\\.0\\.1:5173"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Wolves: build",
      "type": "process",
      "command": "node",
      "args": ["scripts/run-framework.mjs", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Wolves: typecheck",
      "type": "process",
      "command": "node",
      "args": ["node_modules/typescript/bin/tsc", "--noEmit"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$tsc"]
    }
  ]
}
