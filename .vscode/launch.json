{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Wolves: browser (Brave)",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "C:/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe",
      "port": 9231,
      "runtimeArgs": [
        "--remote-debugging-address=127.0.0.1",
        "--remote-debugging-port=9231",
        "http://127.0.0.1:5173"
      ],
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Wolves: dev",
      "postDebugTask": "Wolves: stop dev"
    },
    {
      "name": "Wolves: browser (Edge)",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe",
      "port": 9230,
      "runtimeArgs": [
        "--remote-debugging-address=127.0.0.1",
        "--remote-debugging-port=9230",
        "http://127.0.0.1:5173"
      ],
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Wolves: dev",
      "postDebugTask": "Wolves: stop dev"
    },
    {
      "name": "Wolves: server (Worker)",
      "type": "node",
      "request": "attach",
      "websocketAddress": "ws://127.0.0.1:9229/site-creator-vinext-starter",
      "attachExistingChildren": false,
      "autoAttachChildProcesses": false,
      "resolveSourceMapLocations": null,
      "sourceMaps": true,
      "preLaunchTask": "Wolves: dev",
      "postDebugTask": "Wolves: stop dev",
      "timeout": 30000
    }
  ],
  "compounds": [
    {
      "name": "Wolves: full stack (Brave)",
      "configurations": ["Wolves: browser (Brave)", "Wolves: server (Worker)"],
      "stopAll": true
    },
    {
      "name": "Wolves: full stack (Edge)",
      "configurations": ["Wolves: browser (Edge)", "Wolves: server (Worker)"],
      "stopAll": true
    }
  ]
}
