        "/^node node_modules/eslint/bin/eslint\\.js/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^node node_modules/prettier/bin/prettier\\.cjs/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^node --experimental-strip-types --test/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}