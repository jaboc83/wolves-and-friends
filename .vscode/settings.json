{
    "chat.tools.terminal.autoApprove": {
        ".\\scripts\\runtime\\vscode-node.ps1": true,
        "pnpm lint*": true,
        "pnpm run lint*": true,
        "pnpm build": true,
        "pnpm run build": true,
        "pnpm format*": true,
        "pnpm run format*": true,
        "eslint *": true,
        "prettier *": true,
        "/^git diff /": {
            "approve": true,
            "matchCommandLine": true
